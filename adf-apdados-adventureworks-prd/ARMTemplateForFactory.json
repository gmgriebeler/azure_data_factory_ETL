								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "filter_active_tables",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "read_control_table",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('read_control_table').output.value",
								"type": "Expression"
							},
							"condition": {
								"value": "@bool(item().active)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "filter_active_tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('filter_active_tables').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "child_full_load",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "child_full_load",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"query": {
												"value": "@item().query",
												"type": "Expression"
											},
											"folder": {
												"value": "@item().folder",
												"type": "Expression"
											},
											"file_name": {
												"value": "@item().file_name",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
