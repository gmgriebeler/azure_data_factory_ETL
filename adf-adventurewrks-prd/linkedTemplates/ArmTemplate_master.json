{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-adventurewrks-prd"
		},
		"AD_lakehouse_server_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AD_lakehouse_server'"
		},
		"AD_lakehouse_sqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AD_lakehouse_sqldb'"
		},
		"adls_landing_zone_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adls_landing_zone'"
		},
		"ls_onpremise_adventureworks_dw_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onpremise_adventureworks_dw'"
		},
		"AD_lakehouse_server_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldb-study-lakehouse-server.database.windows.net"
		},
		"AD_lakehouse_server_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"AD_lakehouse_server_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "APRENDER_DADOS_READ"
		},
		"AD_lakehouse_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldb-study-lakehouse-server.database.windows.net"
		},
		"AD_lakehouse_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"AD_lakehouse_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "APRENDER_DADOS_READ"
		},
		"adls_landing_zone_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsadventurewrksprd.dfs.core.windows.net/"
		},
		"ls_onpremise_adventureworks_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-E9T37CGJ\\SQLEXPRESS"
		},
		"ls_onpremise_adventureworks_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksDW2022"
		},
		"ls_onpremise_adventureworks_dw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azure_user"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-adventurewrks-prd_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AD_lakehouse_server_password": {
						"value": "[parameters('AD_lakehouse_server_password')]"
					},
					"AD_lakehouse_sqldb_password": {
						"value": "[parameters('AD_lakehouse_sqldb_password')]"
					},
					"adls_landing_zone_accountKey": {
						"value": "[parameters('adls_landing_zone_accountKey')]"
					},
					"ls_onpremise_adventureworks_dw_password": {
						"value": "[parameters('ls_onpremise_adventureworks_dw_password')]"
					},
					"AD_lakehouse_server_properties_typeProperties_server": {
						"value": "[parameters('AD_lakehouse_server_properties_typeProperties_server')]"
					},
					"AD_lakehouse_server_properties_typeProperties_database": {
						"value": "[parameters('AD_lakehouse_server_properties_typeProperties_database')]"
					},
					"AD_lakehouse_server_properties_typeProperties_userName": {
						"value": "[parameters('AD_lakehouse_server_properties_typeProperties_userName')]"
					},
					"AD_lakehouse_sqldb_properties_typeProperties_server": {
						"value": "[parameters('AD_lakehouse_sqldb_properties_typeProperties_server')]"
					},
					"AD_lakehouse_sqldb_properties_typeProperties_database": {
						"value": "[parameters('AD_lakehouse_sqldb_properties_typeProperties_database')]"
					},
					"AD_lakehouse_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('AD_lakehouse_sqldb_properties_typeProperties_userName')]"
					},
					"adls_landing_zone_properties_typeProperties_url": {
						"value": "[parameters('adls_landing_zone_properties_typeProperties_url')]"
					},
					"ls_onpremise_adventureworks_dw_properties_typeProperties_server": {
						"value": "[parameters('ls_onpremise_adventureworks_dw_properties_typeProperties_server')]"
					},
					"ls_onpremise_adventureworks_dw_properties_typeProperties_database": {
						"value": "[parameters('ls_onpremise_adventureworks_dw_properties_typeProperties_database')]"
					},
					"ls_onpremise_adventureworks_dw_properties_typeProperties_userName": {
						"value": "[parameters('ls_onpremise_adventureworks_dw_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}